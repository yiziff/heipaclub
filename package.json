{
  "name": "cn-rap-cup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "rank:dev": "node scripts/rank-local.mjs",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "db:create": "npx wrangler d1 create heipaclub-rank",
    "db:init": "npx wrangler d1 execute heipaclub-rank --remote --file=./schema.sql",
    "db:init:local": "npx wrangler d1 execute heipaclub-rank --local --file=./schema.sql",
    "enrich": "node scripts/enrich-artwork.mjs",
    "roster": "node scripts/build-roster.mjs && node scripts/rebuild-from-cache.mjs",
    "hot-tops": "node scripts/build-hot-tops.mjs",
    "itunes:map": "node scripts/build-itunes-map.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "vite": "^6.3.5",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
